<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stacking.StackingActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_panel_height"
        app:layout_constraintTop_toTopOf="parent"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="@dimen/nav_panel_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/white"
            android:gravity="center"
            android:textSize="@dimen/nav_title_size"
            android:textStyle="bold"
            android:text="Stacking"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/nav_to_camera_button"
                android:layout_width="@dimen/round_block_size_extended"
                android:layout_height="@dimen/round_block_size_extended"
                android:background="@drawable/round_block_primary"
                android:src="@drawable/icon_camera_nav_btn"
                android:layout_marginRight="@dimen/nav_panel_padding"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/nav_to_stacking_settings_button"
                android:layout_width="@dimen/round_block_size_extended"
                android:layout_height="@dimen/round_block_size_extended"
                android:background="@drawable/round_block_primary"
                android:src="@drawable/icons_settings" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/stacking_controls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_container"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:padding="@dimen/padding_normal">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:useDefaultMargins="true">
            <Button
                android:id="@+id/load_images_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Load Images"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:layout_gravity="fill_horizontal"/>
            <Button
                android:id="@+id/analyse_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyse"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="fill_horizontal"/>
            <CheckBox
                android:id="@+id/analyse_check_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow re-analysis"
                android:layout_row="1"
                android:layout_column="1"/>

            <Button
                android:id="@+id/match_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Match"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_gravity="fill_horizontal"/>

            <Button
                android:id="@+id/stack_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stack"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_gravity="fill_horizontal"/>
            <CheckBox
                android:id="@+id/disable_alignment_check_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disable Alignment"
                android:layout_row="3"
                android:layout_column="1"/>

            <Button
                android:id="@+id/save_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Result"
                android:layout_row="4"
                android:layout_column="0"
                android:layout_gravity="fill_horizontal"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/output_format_selector"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_row="4"
                android:layout_column="1">
                <AutoCompleteTextView
                    android:id="@+id/output_format_selector_auto_complete_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

        </GridLayout>

        <TextView
            android:id="@+id/loaded_images_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images: "
            android:visibility="gone"/>
        <ScrollView
            android:layout_marginVertical="@dimen/big_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/loaded_images_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:showDividers="middle"
                android:divider="@drawable/vertical_divider">
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/log_window_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/stacking_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#88000000"
        android:visibility="gone"/>
    <com.sedv.stackingcamera.stacking.LogWindow
        android:id="@+id/log_window"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/stacking_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/log_view_padding_top"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="@dimen/log_view_elevation"
        app:shapeAppearanceOverlay="@style/LogWindowStyle"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>