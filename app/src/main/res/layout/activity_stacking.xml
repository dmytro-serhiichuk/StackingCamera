<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stacking.StackingActivity"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/primary">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/nav_to_camera_button"
            android:layout_width="@dimen/round_block_size_extended"
            android:layout_height="@dimen/round_block_size_extended"
            android:background="@drawable/round_block_primary"
            android:src="@drawable/icon_camera_nav_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="@dimen/histogram_margin"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/nav_to_stacking_settings_button"
            android:layout_width="@dimen/round_block_size_extended"
            android:layout_height="@dimen/round_block_size_extended"
            android:background="@drawable/round_block_primary"
            android:src="@drawable/icons_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="@dimen/histogram_margin"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="wow"
        android:textColor="@color/white"
        android:gravity="center"/>

</androidx.constraintlayout.widget.ConstraintLayout>