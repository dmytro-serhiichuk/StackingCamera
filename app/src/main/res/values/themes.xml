<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StackingCamera" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.StackingCamera" parent="Base.Theme.StackingCamera" />

    <style name="LogWindowStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/cardview_default_radius</item>
        <item name="cornerSizeTopRight">@dimen/cardview_default_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>